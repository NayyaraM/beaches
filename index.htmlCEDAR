<!DOCTYPE html>
<html lang="en">
  <head>
    <script src="https://cdn.jsdelivr.net/npm/p5@2.3.2/lib/p5.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/p5.sound@0.4.1/dist/p5.sound.min.js"></script>

    <link rel="stylesheet" type="text/css" href="style.css">
    <meta charset="utf-8" />
    <title>Cedar</title>
  </head>
  <body>
    <header class="topbar">
      <button class="menu-btn" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <div class="search-wrap">
        <input type="text" class="search-input" placeholder="Search">
        <span class="search-icon">&#128269;</span>
      </div>
      <div class="profile-icon" aria-label="Profile">&#128100;</div>
    </header>

    <main>
      <div class="title-row">
        <span class="pin-icon">&#128205;</span>
        <h1 class="title">Cedar </h1>
      </div>

      <p class="address">Oriental Blvd. between Ocean Ave. and Mackenzie St.</p>

      <div class="content-grid">
        <div class="info-box">
          <p>
           The city's newest beach is a converted oceanfront bungalow colony. This charming beach is smaller and somewhat more tranquil than its neighbors, Midland Beach and South Beach, and is popular with the area's <families class=""></families>
          </p>
        </div>

        <div class="side-col">
          <div class="image-box">
            <img
              src="https://sandee.com/_next/image?url=https%3A%2F%2Flh5.googleusercontent.com%2Fp%2FAF1QipNCO8favMbun1B49fnybQyox3kuHnG4CKTq6-ux%3Ds1600-k-no&w=3840&q=75"
              alt="Street view of the entrance to Manhattan Beach"
            >
          </div>

          <div class="graph-box">
            <canvas id="graphCanvas" width="300" height="180"></canvas>
            <p class="graph-label">graph</p>
          </div>
        </div>
      </div>
    </main>
    <script src="sketch.js"></script>
  </body>
</html>
